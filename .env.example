# API
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heinicus
JWT_SECRET=change-me
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase (optional; required only for photo/signature/verification uploads)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps / Android
GOOGLE_MAPS_API_KEY=
GOOGLE_SERVICES_JSON=./google-services.json

# EAS
EAS_PROJECT_ID=

# Optional development auth fallback (disabled by default)
EXPO_PUBLIC_ENABLE_DEV_AUTH=false
EXPO_PUBLIC_DEV_ADMIN_EMAIL=admin@example.com
EXPO_PUBLIC_DEV_ADMIN_PASSWORD=
EXPO_PUBLIC_DEV_MECHANIC_EMAIL=mechanic@example.com
EXPO_PUBLIC_DEV_MECHANIC_PASSWORD=
EXPO_PUBLIC_DEV_CUSTOMER_EMAIL=customer@example.com
EXPO_PUBLIC_DEV_CUSTOMER_PASSWORD=
