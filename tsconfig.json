{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@trpc/server": [
        "./node_modules/@trpc/server/dist/index.d.cts"
      ],
      "@trpc/server/adapters/fetch": [
        "./node_modules/@trpc/server/dist/adapters/fetch/index.d.cts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "basic-android",
    "logs",
    ".expo",
    "dist"
  ]
}
